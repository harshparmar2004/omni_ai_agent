{
  "name": "omnistudio-ai",
  "version": "7.0.0",
  "description": "OmniStudio v7 — Autonomous Two-Agent Instagram Platform (Reposter & Watchtower)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/v7_subsystems.test.js",
    "bot:local": "node -e \"require('./src/agents/reposter/telegramBot').startTelegramBot({ forcePolling: true })\"",
    "bot:status": "node scripts/telegram_switch.js status",
    "bot:switch:local": "node scripts/telegram_switch.js local",
    "bot:switch:cloud": "node scripts/telegram_switch.js cloud"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "axios": "^1.6.8",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^181.0.0",
    "libsodium-wrappers": "^0.8.4",
    "localtunnel": "^2.0.2",
    "marked": "^18.0.14",
    "pdfkit": "^0.20.2",
    "tesseract.js": "^7.0.0"
  }
}
