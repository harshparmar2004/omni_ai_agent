# Server Port
PORT=4000

# Meta Graph API Credentials (Instagram Business Account)
META_PAGE_TOKEN=your_meta_page_token_here
META_IG_USER_ID=your_meta_ig_user_id_here

# Telegram Mobile Harvester Bot (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Model Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Local Ollama Endpoint (Optional)
OLLAMA_ENDPOINT=http://localhost:11434/api/chat

# AI Influencer Avatar Layer - Alibaba Wan 2.1 Video Foundation Model
# Fal.ai serverless endpoint (recommended: fast, zero infra, ~$0.05/video)
FAL_KEY=your_fal_ai_key_here

# Alibaba Cloud DashScope / Bailian API (direct upstream Alibaba Wan API)
ALIBABA_WAN_API_KEY=your_alibaba_wan_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Self-Hosted ComfyUI / RunPod RTX 4090 Endpoint (Optional, ~$0.008/video)
WAN_COMFYUI_URL=http://localhost:8188

# Toggle mock/simulation mode (true = fast local offline filter pass, false = cloud GPU)
MOCK_AI_INFLUENCER=false
