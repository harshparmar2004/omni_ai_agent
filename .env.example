# Server Port
PORT=4000

# Meta Graph API Credentials (Instagram Business Account)
META_PAGE_TOKEN=your_meta_page_token_here
META_IG_USER_ID=your_meta_ig_user_id_here

# Telegram Mobile Harvester Bot (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Model Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Local Ollama Endpoint (Optional)
OLLAMA_ENDPOINT=http://localhost:11434/api/chat

# AI Influencer Avatar Layer - Alibaba Wan 3.0 Prime Video Foundation Model
# Official Alibaba Cloud Model Studio / DashScope API (Direct Upstream Engine)
DASHSCOPE_API_KEY=your_alibaba_dashscope_api_key_here
ALIBABA_WAN_API_KEY=your_alibaba_dashscope_api_key_here
# Optional: Set to https://dashscope-intl.aliyuncs.com for Singapore/International accounts (default: https://dashscope.aliyuncs.com)
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# Optional Alternative: Fal.ai Serverless Key
FAL_KEY=your_fal_ai_key_here

# Toggle mock/simulation mode (true = fast local offline filter pass, false = official cloud API)
MOCK_AI_INFLUENCER=false

