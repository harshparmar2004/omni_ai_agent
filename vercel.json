{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron-trigger",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron-trigger",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron-trigger",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron-trigger",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron-trigger",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron-trigger",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron-trigger",
      "schedule": "45 15 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
